# LINE Messaging API（只放 Railway / .env.local，不要寫進程式碼）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login（LIFF／驗證 ID Token 用，與上面 Messaging API 不是同一組）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LIFF App ID（建立 LIFF 後出現，格式如 1234567890-AbCdEfGh）
NEXT_PUBLIC_LINE_LIFF_ID=

# Railway MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# 1:1 預約成立時額外通知的管理員 LINE userId，逗號分隔（Phase 2）
ADMIN_LINE_USER_IDS=
