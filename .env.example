# LINE Messaging API（只放 Railway / .env.local，不要寫進程式碼）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login Channel ID 必填（驗 LIFF ID Token）；Secret 目前程式未用來驗證
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LIFF App ID（建立 LIFF 後出現，格式如 1234567890-AbCdEfGh）
NEXT_PUBLIC_LINE_LIFF_ID=

# Railway MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# 1:1 訂單成立時額外通知的管理員 LINE userId，逗號分隔（Phase 2）
ADMIN_LINE_USER_IDS=

# AI 對話（Phase 3）。DeepSeek 走 OpenAI 相容協定
DEEPSEEK_API_KEY=
# 以下都可不填，留空即用預設值
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash
AI_CLASSIFY_MODEL=deepseek-v4-flash
# 產品問答是否允許網路搜尋補充（DeepSeek /responses 伺服器端搜尋），off 則只讀 docs/faq.md
AI_WEB_SEARCH=on
