generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ProcessedEvent {
  id        String   @id @map("webhook_event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_events")
}

model User {
  lineUserId  String    @id @map("line_user_id")
  displayName String?   @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  bookings    Booking[]

  @@map("users")
}

model Booking {
  id          String   @id @default(cuid())
  lineUserId  String   @map("line_user_id")
  user        User     @relation(fields: [lineUserId], references: [lineUserId])
  name        String
  phone       String
  bookingDate DateTime @map("booking_date") @db.Date
  bookingSlot String   @map("booking_slot")
  bookingItem String   @map("booking_item")
  notes       String?  @db.Text
  status      String   @default("confirmed")
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([lineUserId])
  @@index([bookingDate])
  @@map("bookings")
}
