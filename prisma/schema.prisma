generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ProcessedEvent {
  id        String   @id @map("webhook_event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_events")
}

model User {
  lineUserId  String   @id @map("line_user_id")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      Order[]

  @@map("users")
}

/// 一個對話串：1:1 用 userId，群組用 groupId，多人聊天室用 roomId。
model Conversation {
  key            String        @id @map("conversation_key")
  kind           String
  smalltalkTurns Int           @default(0) @map("smalltalk_turns")
  lastIntent     String?       @map("last_intent")
  closedAt       DateTime?     @map("closed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  messages       ChatMessage[]

  @@map("conversations")
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationKey String       @map("conversation_key")
  conversation    Conversation @relation(fields: [conversationKey], references: [key], onDelete: Cascade)
  role            String
  content         String       @db.Text
  intent          String?
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([conversationKey, createdAt])
  @@map("chat_messages")
}

model Order {
  id         String   @id @default(cuid())
  lineUserId String   @map("line_user_id")
  user       User     @relation(fields: [lineUserId], references: [lineUserId])
  name       String
  phone      String
  orderDate  DateTime @map("order_date") @db.Date
  orderItem  String   @map("order_item")
  plainQty   Int      @default(0) @map("plain_qty")
  spicyQty   Int      @default(0) @map("spicy_qty")
  address    String?  @db.Text
  notes      String?  @db.Text
  status     String   @default("confirmed")
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([lineUserId])
  @@index([orderDate])
  @@map("orders")
}
